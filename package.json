{
  "name": "visual-lens",
  "version": "1.0.0",
  "private": true,
  "description": "VisualLens: AI-powered Visual Regression Testing Agent",
  "license": "MIT",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "setup:backend": "bash backend/setup.sh",
    "setup:all": "npm install && npm run setup:backend",
    "start:frontend": "npm run dev --workspace=frontend -- --port 3000",
    "start:backend": "backend/.venv/bin/uvicorn main:app --app-dir backend --host 0.0.0.0 --port 8000 --reload --reload-dir backend",
    "dev": "concurrently -c \"blue.bold,green.bold\" -n \"FRONTEND,BACKEND\" \"npm run start:frontend\" \"npm run start:backend\""
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
