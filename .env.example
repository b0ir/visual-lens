# VisualLens environment configuration.
# Copy to .env (backend) / .env.local (frontend) and adjust as needed.
# All values below are the built-in defaults; override only if necessary.

# --- Backend ---

# Comma-separated list of origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:3000

# Seconds to wait for manual login during interactive auth crawls.
LOGIN_TIMEOUT_SECONDS=300

# --- Frontend (Vite) ---

# Base URL the frontend uses to reach the backend API.
VITE_API_URL=http://localhost:8000

# Note: AI provider API keys are NOT configured here. They are entered in the
# UI Settings and stored client-side (browser localStorage), then sent
# per-request to the backend and passed straight to LiteLLM. Keys are never
# read from the environment or persisted server-side.
